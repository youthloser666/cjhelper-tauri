{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cjhelper-app",
  "version": "0.1.0",
  "identifier": "com.aldo.cjhelper-app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "cjhelper-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    },
    "plugins": {
      "updater": {
        "endpoints": [
          "https://github.com/user/repo/releases/latest/download/latest.json"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
